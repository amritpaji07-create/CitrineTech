
@model CitrineTechData.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .fade-in {
            animation: fadeIn 0.8s ease-in-out forwards;
            opacity: 0;
        }

        @@keyframes fadeIn {
            to { opacity: 1; }
        }

        /* Floating labels */
        .floating-label input:focus + label,
        .floating-label input:not(:placeholder-shown) + label {
            top: -10px;
            left: 10px;
            font-size: 12px;
            background: rgba(17, 24, 39, 1);
            padding: 0px 6px;
            color: #60a5fa;
        }
        .floating-label label {
            pointer-events: none;
            position: absolute;
            left: 14px;
            top: 12px;
            color: #d1d5db;
            transition: all 0.2s ease;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-gray-900 via-slate-800 to-gray-900 min-h-screen flex items-center justify-center">

    <div class="fade-in w-full 
                max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl 
                bg-white/10 border border-white/20 backdrop-blur-xl 
                text-white rounded-2xl shadow-[0_8px_32px_rgba(0,0,0,0.4)] 
                p-6 sm:p-8 md:p-10 mx-4">

        <!-- Logo / Title -->
        <div class="text-center mb-6 sm:mb-8">
            <div class="mx-auto mb-4 w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 
                        rounded-full bg-blue-600/30 flex items-center justify-center shadow-lg">
                <span class="text-2xl sm:text-3xl md:text-4xl font-bold text-blue-300">CT</span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold drop-shadow-md">
                Admin Panel
            </h1>

            <p class="text-gray-300 text-xs sm:text-sm mt-2 tracking-wide">
                Secure Access Only
            </p>
        </div>

        <!-- Form -->
        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5 sm:space-y-6">

            <!-- Email -->
            <div class="floating-label relative">
                <input asp-for="Email"
                       placeholder=" "
                       class="w-full px-4 py-3 bg-gray-900/50 border border-white/20 
                              rounded-lg text-gray-100 text-sm sm:text-base
                              focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"/>
                <label class="text-sm">Email</label>
            </div>

            <!-- Password -->
            <div class="floating-label relative">
                <input asp-for="Password" type="password"
                       placeholder=" "
                       class="w-full px-4 py-3 bg-gray-900/50 border border-white/20 
                              rounded-lg text-gray-100 text-sm sm:text-base
                              focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"/>
                <label class="text-sm">Password</label>
            </div>

            <!-- Error Message -->
            @if (ViewBag.Error != null)
            {
                <p class="text-red-400 text-center text-sm font-medium">@ViewBag.Error</p>
            }

            <!-- Submit Button -->
            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 active:scale-95 transition
                           text-white font-semibold py-3 rounded-lg shadow-lg shadow-blue-900/40
                           text-sm sm:text-base">
                Login
            </button>
        </form>

        <!-- Footer -->
        <p class="mt-8 text-center text-xs sm:text-sm text-gray-400">
            © @DateTime.Now.Year Citrine Technology — All Rights Reserved
        </p>

    </div>

</body>
</html>










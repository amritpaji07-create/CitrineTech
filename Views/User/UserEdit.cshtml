@using CitrineTechData.DataModel
@model User

@{
    ViewData["Title"] = "User Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
}

<div class="max-w-7xl mx-auto mt-6 px-4">
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="bg-gray-800 text-white px-6 py-4">
            <h4 class="text-xl font-semibold">Edit User</h4>
        </div>
        <div class="p-6">
            <form asp-action="UserEdit" enctype="multipart/form-data" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
                <input type="hidden" asp-for="Id" />

               
                <div>
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Name" class="mt-1 p-2 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Email" type="email" class="mt-1 p-2 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                </div>

               
                <div>
                    <label asp-for="ContactNo" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="ContactNo" type="tel" class="mt-1 p-2 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"></input>
                    <span asp-validation-for="ContactNo" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Role" class="block text-sm font-medium text-gray-700 mb-2">Role</label>

                    <div class="space-y-2">
                        <div class="flex items-center">
                            <input type="radio" asp-for="Role" value="Admin" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" />
                            <label class="ml-2 text-sm text-gray-700">Admin</label>
                        </div>
                        <div class="flex items-center">
                            <input type="radio" asp-for="Role" value="User" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" />
                            <label class="ml-2 text-sm text-gray-700">User</label>
                        </div>
                        <div class="flex items-center">
                            <input type="radio" asp-for="Role" value="Guest" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" />
                            <label class="ml-2 text-sm text-gray-700">Guest</label>
                        </div>
                    </div>

                    <span asp-validation-for="Role" class="text-red-600 text-sm mt-1 block"></span>
                </div>
                
                                
                <!-- Buttons -->
                <div class="flex justify-between mt-6">
                    <input type="submit" value="Update" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition" />
                    <a asp-action="Users" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600 transition">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["SuccessMessage"]',
                    confirmButtonColor: '#3085d6'
                });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#d33'
                });
        </text>
    }
                });
</script>
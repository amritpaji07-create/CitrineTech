@model List<CitrineTechData.ViewModel.ServiceViewModel>



@{
    ViewData["Title"] = "Our Services";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<style>

    /* === Common Palette === */
    :root {
        --oxford-blue-dark: #0c1425;
        --oxford-blue: #14213d;
        --oxford-blue-light: #29447e;
        --orange: #fca311;
        --orange-light: #fec871;
        --platinum: #e5e5e5;
        --white: #ffffff;
        --black: #000000;
    }


    .scroll-zoom {
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    #scrollBlogContent {
        transform-origin: center;
    }
        
    section {
        scroll-margin-top: 100px;
    }

    /* === HERO SECTION === */
    .hero1 {
        background: linear-gradient(135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100%);
        color: var(--white);
        position: relative;
        overflow: hidden;
    }

        .hero1::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(252,163,17,0.25), transparent 70%), radial-gradient(circle at bottom left, rgba(20,33,61,0.4), transparent 70%);
            opacity: 0.8;
        }

        .hero1 h2 {
            color: var(--orange);
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
        }

        .hero1 a {
            color: var(--orange);
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .hero1 a:hover {
                color: var(--orange-light);
                text-decoration: underline;
            }

</style>

<section class="hero1 relative px-2 h-100 overflow-hidden mb-8">
    <div class="max-w-7xl mx-auto text-white sm:px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-sm-2" style="margin-top:50px;">

        <!-- Left Content -->
        <div class="w-full md:w-1/2 flex flex-col items-center text-center text-white py-12 z-10">
            <h2 class="text-4xl sm:text-5xl font-bold mb-2">@ViewData["Title"]</h2>
            <p class="text-yellow-400 scroll-animate opacity-0" data-animate="slide-in-left">
                <a asp-action="Index">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>

        <!-- Right Image -->
        <div class="w-full md:w-1/2 flex items-center justify-center relative overflow-hidden">
            <img id="scrollImage"
                 src="~/img/Fun.png"
                 alt="Engineers"
                 class="w-full h-auto transition-transform duration-300 ease-out will-change-transform">
        </div>
    </div>
</section>

<script>
    window.addEventListener("scroll", function () {
        // === Image Animation ===
        const image = document.getElementById("scrollImage");
        const heroSection = document.querySelector(".hero1");
        const heroRect = heroSection.getBoundingClientRect();

        let imageProgress = 1 - (heroRect.bottom / window.innerHeight);
        imageProgress = Math.min(Math.max(imageProgress, 0), 1);

        const imageScale = 1 + imageProgress * 0.8;   // 1 → 1.8
        const imageOpacity = 1 - imageProgress * 0.6; // 1 → 0.4

        image.style.transform = `scale(${imageScale})`;
        image.style.opacity = imageOpacity;


        // === Blog Content Animation ===
        const content = document.getElementById("scrollBlogContent");
        const blogSection = document.querySelector("#scrollBlogContent"); // ⚠️ make sure your blog section has class="blog"
        if (content && blogSection) {
            const blogRect = blogSection.getBoundingClientRect();

            let contentProgress = 1 - (blogRect.bottom / window.innerHeight);
            contentProgress = Math.min(Math.max(contentProgress, 0), 1);

            const translateY = contentProgress * -40; // move upward
            const contentScale = 1 + contentProgress * 0.1; // 1 → 1.1
            const contentOpacity = 1 - contentProgress * 0.6; // 1 → 0.4

            content.style.transform = `translateY(${translateY}px) scale(${contentScale})`;
            content.style.opacity = contentOpacity;
        }
    });
</script>


<!-- Service Cards -->
<section class="mx-3 py-20">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8 ">
        @foreach (var item in Model)
        {
            <div class="bg-[#374562] rounded-2xl overflow-hidden text-white flex flex-col md:flex-row shadow-md scroll-animate opacity-0 delay-150" data-animate="slide-in-right">
                <div class="p-6 flex-1">
                    <p class="text-sm text-gray-300 mb-1">@item.SubTitle</p>
                    <h3 class="text-xl font-bold mb-2 text-yellow-300">@item.Name</h3>
                    <p class="text-sm text-white/90 mb-4 text-justify">
                        @item.Description
                    </p>
                    <button class="bg-yellow-400 text-black font-semibold px-4 py-2 rounded-full text-sm hover:opacity-90 transition">
                        <a href="@Url.Action("Details", "Service", new { Id = item.Id })"> Read Detail</a>
                    </button>
                    @* <div class="flex items-center gap-3 mt-4 text-sm text-white/80">
                <span class="flex items-center gap-1"><i class="fas fa-building"></i> Urban Mall</span>
                <span class="flex items-center gap-1"><i class="fas fa-map-marker-alt"></i>India</span>
                </div> *@
                </div>
                <img src="/@item.ImageUrl" alt="Urban Mall" class="h-48 md:h-auto md:w-48 object-cover">
            </div>
        }
    </div>
</section>


@model CitrineTechData.ViewModel.ServiceViewModel

@{
    ViewData["Title"] = "Service Details";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<!-- 🌟 PAGE STYLES -->
<style>
    /* Scroll-based fade and slide animation */
    [data-animate] {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
    }

        [data-animate].visible {
            opacity: 1;
            transform: translateY(0);
        }

    #scrollImage {
        transition: transform 0.6s ease, opacity 0.6s ease;
    }

    /* Floating default images */
    .floating-img {
        position: absolute;
        opacity: 0.25;
        filter: blur(0.5px) brightness(1.1);
        animation: float 8s ease-in-out infinite;
        transition: all 0.6s ease;
        will-change: transform;
    }

        .floating-img:hover {
            opacity: 0.6;
            filter: brightness(1.3);
            transform: scale(1.05);
        }

    @@keyframes float {
        0%

    {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-20px);
    }

    100% {
        transform: translateY(0px);
    }

    }

    /* Glassmorphic card */
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 215, 0, 0.4);
    }

    .sub-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }

    .gradient-text {
        background: linear-gradient(to right, #facc15, #fff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .divider {
        height: 3px;
        width: 80px;
        margin: 1.5rem auto;
        background: linear-gradient(to right, #facc15, #fbbf24, #facc15);
        border-radius: 2px;
    }
</style>

<!-- ===== HERO SECTION ===== -->
<section class="relative overflow-hidden bg-gradient-to-r from-black via-gray-900 to-black shadow-2xl">
    <!-- Floating Default Images -->
    @* <img src="~/assets/123.png" class="floating-img w-24 top-10 left-16 animate-pulse" style="animation-delay: 0s;" alt="Floating Icon" />
    <img src="~/img/icons/ai.png" class="floating-img w-28 bottom-12 right-10" style="animation-delay: 2s;" alt="AI Icon" />
    <img src="~/img/icons/data.png" class="floating-img w-20 top-1/3 right-1/4" style="animation-delay: 4s;" alt="Data Icon" />
 *@
    <div class="max-w-7xl mx-auto text-white px-6 py-20 flex flex-col md:flex-row items-center justify-between gap-10 relative z-10">
        <!-- Left Content -->
        <div class="flex-1 text-center md:text-left space-y-6" data-animate>
            <h1 class="text-5xl md:text-6xl font-extrabold gradient-text drop-shadow-xl">
                @Model.Name
            </h1>
            <p class="text-lg text-gray-300 max-w-lg leading-relaxed">
                Empowering your business with cutting-edge digital solutions crafted to deliver performance, precision, and excellence.
            </p>
        </div>

        <!-- Right Image -->
        <div class="flex-1 flex justify-center relative" data-animate>
            <img id="scrollImage"
                 src="~/assets/123.png"
                 alt="Service Image"
                 class="max-w-md w-full rounded-2xl shadow-2xl opacity-95  hover:opacity-100 transition-all duration-700" />
        </div>
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
</section>

<!-- ===== MAIN CONTENT ===== -->
<section id="scrollBlogContent" class="relative max-w-6xl mx-auto my-20 px-5">
    <div class="rounded-3xl overflow-hidden shadow-2xl glass-card" data-animate>
        <img src="@Url.Content("/" + (string.IsNullOrEmpty(Model.ImageUrl) ? "img/default.jpg" : Model.ImageUrl))"
             alt="@Model.Name" class="w-full h-[400px] object-cover" />

        <div class="p-10 space-y-5 text-gray-800">
            <h2 class="text-4xl font-extrabold text-center gradient-text">
                @Model.Name
            </h2>
            <div class="divider"></div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-lg leading-relaxed text-justify text-gray-700">
                    @Model.Description
                </p>
            }
            else
            {
                <p class="text-lg text-gray-600 text-center">Description coming soon...</p>
            }
        </div>
    </div>
</section>

<!-- ===== SUBSERVICES ===== -->
@if (Model.SubService != null && Model.SubService.Any())
{
    <section class="max-w-7xl mx-auto py-20 px-5" data-animate>
        <h2 class="text-3xl md:text-4xl font-bold text-center gradient-text mb-6">
            Our Sub Services
        </h2>
        <div class="divider"></div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 mt-10">
            @foreach (var sub in Model.SubService)
            {
                <div class="group sub-card glass-card rounded-2xl shadow-lg transition-all duration-500 overflow-hidden" data-animate>
                    @if (!string.IsNullOrEmpty(sub.ImageUrl))
                    {
                        <div class="relative overflow-hidden">
                            <img src="@Url.Content("~/" + sub.ImageUrl)" alt="@sub.Name"
                                 class="w-full h-56 object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>                            
                        </div>
                    }

                    <div class="p-6">
                        @if (!string.IsNullOrEmpty(sub.Description))
                        {
                            <h3 class="bottom-4 left-4 font-bold text-center text-black drop-shadow-md">
                                @sub.Name
                            </h3>

                            <p class="text-gray-800 text-sm leading-relaxed line-clamp-4">
                                @sub.Description
                            </p>
                        }
                        else
                        {
                            <p class="text-gray-500 text-sm italic">Details coming soon...</p>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ===== JS: SCROLL EFFECTS ===== -->
<script>
    // Zoom effect on scroll
    window.addEventListener("scroll", function () {
        const img = document.getElementById("scrollImage");
        const rect = img.getBoundingClientRect();
        const progress = Math.max(0, 1 - rect.top / window.innerHeight);
        const scale = 1 + progress * 0.3;
        const opacity = 1 - progress * 0.2;
        img.style.transform = `scale(${scale})`;
        img.style.opacity = opacity;
    });

    // Reveal on scroll
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.2 });

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
</script>

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="">
    <meta name="description" content="">

    <title>@ViewBag.Title</title>

    <!-- CSS Libraries -->
    <!-- Icon Fonts -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />

    <link href="~/css/output.css" rel="stylesheet">
    <link href="~/New_assets/css/animate.css" rel="stylesheet">
    <link href="~/css/site.css" />

    <style>       
       
        .hero {
            border-bottom-left-radius: 0.5rem; /* 8px */
            border-bottom-right-radius: 0.5rem; /* 8px */
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
            width: 100%;
            background-color: transparent;
            transform: translateY(-10px); /* slight offset for animation */
            transition: transform 0.4s ease, border-bottom 0.4s ease, background-color 0.4s ease;
        }

        .hero {
            padding-top: 100px; /* match your header height */
        }

        /* ===== Header (Oxford–Orange Palette) ===== */
        header {
            background-color: transparent;
            transition: all 0.4s ease;
        }

        .header-scrolled {
            background: linear-gradient(90deg, #14213D, #000000);
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.25);
        }

        /* Fade Animation for Sections */
        .fade-section {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
        }

            .fade-section.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* ===== Footer Styling (Oxford–Orange Palette) ===== */
        .footer-bg {
            /* background: linear-gradient(135deg, #14213D, #000000, #14213D); */
            /* color: #E5E5E5; */
            /* color: black; */
            background: linear-gradient(135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100%);
            /* border-radius: 1.5rem; */
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.25);
        }

        .footer-heading {
            /* color: #FCA311; */
            border-bottom: 2px solid #FCA311;
            display: inline-block;
            padding-bottom: 0.25rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .footer-text-highlight {
            /* color: #FCA311; */
        }

        .footer-link {
            /* color: #E5E5E5; */
            transition: 0.3s ease;
        }

            .footer-link:hover {
                /* color: #FCA311; */
            }

        .footer-icon {
            color: #FFFFFF;
            transition: 0.3s ease;
        }

            .footer-icon:hover {
                /* color: #FCA311; */
                transform: scale(1.1);
            }

        .footer-bottom {
            border-top: 1px solid #FCA311;
            color: #CCCCCC;
        }

            .footer-bottom a:hover {
                color: #FCA311;
            }

            .footer-bottom span {
                color: #FCA311;
            }

        /* === Common Palette === */
        :root {
            --oxford-blue-dark: #0c1425;
            --oxford-blue: #14213d;
            --oxford-blue-light: #29447e;
            --orange: #fca311;
            --orange-light: #fec871;
            --platinum: #e5e5e5;
            --white: #ffffff;
            --black: #000000;
        }

        section {
            scroll-margin-top: 100px;
        }

        /* === HERO SECTION === */
        .hero1 {
            background: linear-gradient(135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100%);
            color: var(--white);
            position: relative;
            overflow: hidden;
        }

            .hero1::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at top right, rgba(252,163,17,0.25), transparent 70%), radial-gradient(circle at bottom left, rgba(20,33,61,0.4), transparent 70%);
                opacity: 0.8;
            }

            .hero1 h2 {
                color: var(--orange);
                text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
            }

            .hero1 a {
                color: var(--orange);
                font-weight: 600;
                transition: color 0.3s ease;
            }

                .hero1 a:hover {
                    color: var(--orange-light);
                    text-decoration: underline;
                }

        /* === ABOUT SECTION === */
        .about-section {
            /* background: linear-gradient(160deg, #ffffff, #f9f9f9, #f0f4f8); */
            color: var(--oxford-blue);
            /* border: 1px solid rgba(20, 33, 61, 0.1); */
        }

        .about-tag {
            border: 1px solid var(--orange);
            color: var(--oxford-blue);
            background: rgba(252, 163, 17, 0.1);
        }

        .about-title span {
            color: var(--orange);
            text-shadow: 0 1px 6px rgba(252, 163, 17, 0.2);
        }

        .about-card-dark {
            background: linear-gradient(145deg, var(--oxford-blue), var(--oxford-blue-light));
            color: var(--platinum);
            box-shadow: 0 10px 25px rgba(20, 33, 61, 0.4);
            border: 1px solid rgba(252, 163, 17, 0.3);
        }

        .about-card-light {
            background: linear-gradient(145deg, #ffffff, #f7f9fc);
            color: var(--oxford-blue);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(252, 163, 17, 0.2);
        }

            .about-card-dark:hover, .about-card-light:hover {
                transform: translateY(-5px);
            }

        /* === WHY CHOOSE SECTION === */
        .why-section {
            /* background: linear-gradient(150deg, #ffffff, #f5f7fa); */
            color: var(--oxford-blue);
            /* position: relative; */
        }

            .why-section::before {
                content: "";
                position: absolute;
                top: -50px;
                left: 0;
                right: 0;
                height: 100px;
                background: linear-gradient(to bottom, rgba(20,33,61,0.05), transparent);
            }

        .why-heading {
            color: var(--oxford-blue);
            text-shadow: 0 2px 6px rgba(41,68,126,0.2);
        }

        .feature-box {
            background: linear-gradient(160deg, var(--oxford-blue), var(--oxford-blue-light));
            color: var(--platinum);
            box-shadow: 0 8px 20px rgba(41,68,126,0.5);
            border-left: 4px solid var(--orange);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .feature-box:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(252, 163, 17, 0.4);
            }

        .feature-index {
            background: var(--orange);
            color: var(--black);
            font-weight: bold;
            border-top-right-radius: 0.5rem;
            border-bottom-right-radius: 0.5rem;
        }

        /* === TEAM SECTION === */
        .team-section {
            background: linear-gradient(135deg, #f5f7fa, #ffffff);
            color: var(--oxford-blue);
            position: relative;
            overflow: hidden;
        }

            .team-section::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 80% 20%, rgba(41,68,126,0.08), transparent 60%);
            }

        .team-card {
            background: linear-gradient(180deg, var(--oxford-blue), var(--oxford-blue-light));
            color: var(--platinum);
            transition: transform 0.4s ease, box-shadow 0.4s ease, border 0.3s ease;
            border: 1px solid rgba(252, 163, 17, 0.3);
        }

            .team-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 30px rgba(41, 68, 126, 0.5);
                border-color: var(--orange);
            }

            .team-card a {
                border-color: var(--orange);
                color: var(--orange);
                transition: all 0.3s ease;
            }

                .team-card a:hover {
                    background: var(--orange);
                    color: var(--oxford-blue);
                }

        /* === BUTTON === */
        .gold-btn {
            background: linear-gradient(90deg, var(--orange), var(--orange-light));
            color: var(--oxford-blue);
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(252, 163, 17, 0.3);
        }

            .gold-btn:hover {
                transform: scale(1.05);
                background: linear-gradient(90deg, var(--orange-light), var(--orange));
                box-shadow: 0 8px 20px rgba(252, 163, 17, 0.5);
            }
    </style>

</head>
<body class="">


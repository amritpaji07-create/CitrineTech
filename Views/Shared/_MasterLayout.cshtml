            <a asp-action="OurServices" asp-controller="Service" class="block py-2 text-white hover:text-[#FCA311] font-semibold">Service</a>
            <a asp-action="Solutions" asp-controller="Home" class="block py-2 text-white hover:text-[#FCA311] font-semibold">Solution</a>
@* 
            <!-- Render NavbarMenu component directly -->

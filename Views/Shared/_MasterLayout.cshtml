            <a asp-action="Create" asp-controller="Contact" class="block py-2 text-white hover:text-[#FCA311] font-semibold">Contact</a>
            <a asp-action="Create" asp-controller="Contact"
               class="block mt-3 bg-[#FCA311] text-black px-5 py-2 rounded-full border border-[#FCA311] text-center shadow-[0_0_15px_#FCA311]">

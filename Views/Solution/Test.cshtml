@{
    ViewData["Title"] = "Digital Solutions";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}




<style>
    .scroll-zoom {
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    #scrollBlogContent {
        transform-origin: center;
    }

</style>

<section class="hero1 mx-3 bg-gradient-to-r from-[#051b11] via-[#123d2d] to-[#a47e1f] relative px-2 h-100 rounded-2xl overflow-hidden">
    <div class="max-w-7xl mx-auto text-white sm:px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-sm-2">

        <!-- Left Content -->
        <div class="w-full md:w-1/2 flex flex-col items-center text-center text-white py-12 z-10">
            <h2 class="text-4xl sm:text-5xl font-bold mb-2">@ViewData["Title"]</h2>
            <p class="text-yellow-400 scroll-animate opacity-0" data-animate="slide-in-left">
                <a asp-action="Index">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>

        <!-- Right Image -->
        <div class="w-full md:w-1/2 flex items-center justify-center relative overflow-hidden">
            <img id="scrollImage"
                 src="~/img/Fun.png"
                 alt="Engineers"
                 class="w-full h-auto transition-transform duration-300 ease-out will-change-transform">
        </div>
    </div>
</section>

<script>
    window.addEventListener("scroll", function () {
        // === Image Animation ===
        const image = document.getElementById("scrollImage");
        const heroSection = document.querySelector(".hero1");
        const heroRect = heroSection.getBoundingClientRect();

        let imageProgress = 1 - (heroRect.bottom / window.innerHeight);
        imageProgress = Math.min(Math.max(imageProgress, 0), 1);

        const imageScale = 1 + imageProgress * 0.8;   // 1 → 1.8
        const imageOpacity = 1 - imageProgress * 0.6; // 1 → 0.4

        image.style.transform = `scale(${imageScale})`;
        image.style.opacity = imageOpacity;


        // === Blog Content Animation ===
        const content = document.getElementById("scrollBlogContent");
        const blogSection = document.querySelector("#scrollBlogContent"); // ⚠️ make sure your blog section has class="blog"
        if (content && blogSection) {
            const blogRect = blogSection.getBoundingClientRect();

            let contentProgress = 1 - (blogRect.bottom / window.innerHeight);
            contentProgress = Math.min(Math.max(contentProgress, 0), 1);

            const translateY = contentProgress * -40; // move upward
            const contentScale = 1 + contentProgress * 0.1; // 1 → 1.1
            const contentOpacity = 1 - contentProgress * 0.6; // 1 → 0.4

            content.style.transform = `translateY(${translateY}px) scale(${contentScale})`;
            content.style.opacity = contentOpacity;
        }
    });
</script>


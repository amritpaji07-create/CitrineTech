@using CitrineTechData.ViewModel
@model ContactViewModel


@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<style>

    /* === Common Palette === */
    :root {
        --oxford-blue-dark: #0c1425;
        --oxford-blue: #14213d;
        --oxford-blue-light: #29447e;
        --orange: #fca311;
        --orange-light: #fec871;
        --platinum: #e5e5e5;
        --white: #ffffff;
        --black: #000000;
    }


    .scroll-zoom {
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    #scrollBlogContent {
        transform-origin: center;
    }

    section {
        scroll-margin-top: 100px;
    }

    /* === HERO SECTION === */
    .hero1 {
        background: linear-gradient(135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100%);
        color: var(--white);
        position: relative;
        overflow: hidden;
    }

        .hero1::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(252,163,17,0.25), transparent 70%), radial-gradient(circle at bottom left, rgba(20,33,61,0.4), transparent 70%);
            opacity: 0.8;
        }

        .hero1 h2 {
            color: var(--orange);
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
        }

        .hero1 a {
            color: var(--orange);
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .hero1 a:hover {
                color: var(--orange-light);
                text-decoration: underline;
            }

</style>



<!-- Hero Section -->
<section class="hero1 relative px-2 h-100 overflow-hidden mb-8">
    <div class="max-w-7xl mx-auto text-white sm:px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-sm-2" style="margin-top:50px;">

        <!-- Left Content -->
        <div class="w-full md:w-1/2 flex flex-col items-center text-center text-white py-12">
            <h2 class="text-4xl sm:text-5xl font-bold mb-2"> @ViewData["Title"]</h2>
            <p class="text-lime-400">
                <a asp-controller="Home" asp-action="Index" style="color:gold;"> Home </a><span class="text-white">–  @ViewData["Title"]</span>
            </p>
        </div>

        <!-- Right Image -->
        <div class="w-full md:w-1/2 items-center">
            <img src="~/img/1-Photoroom-removebg-preview.png"
                 alt="Engineers"
                 class="w-full h-auto animate-wave">
        </div>
    </div>
</section>


<section class="mx-3 py-16 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Left: Form -->
        <div class="w-full rounded-2xl shadow-lg p-6 sm:p-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Send Us a Message</h2>
            <p class="text-gray-600 mb-6 sm:mb-8">
                Have questions or want to get started? Fill out the form and our team will get back to you soon.
            </p>

            <form asp-action="Create" asp-controller="Contact" enctype="multipart/form-data" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="bg-red-100 text-red-700 p-4 rounded"></div>
                <!-- Name + Email -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-base font-medium mb-1">Your Name <span class="text-red-500">*</span></label>
                        <input type="text" placeholder="e.g. Jason Samuel" asp-for="Name"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-lime-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-base font-medium mb-1">Your Email <span class="text-red-500">*</span></label>
                        <input type="email" placeholder="e.g. test@gmail.com" asp-for="Email"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-lime-400 focus:outline-none">
                    </div>
                </div>

                <!-- Phone + Subject -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-base font-medium mb-1">Phone <span class="text-red-500">*</span></label>
                        <input type="text" placeholder="e.g 7894587878" asp-for="ContactNo"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-lime-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-base font-medium mb-1">Subject <span class="text-red-500">*</span></label>
                        <input type="text" placeholder="e.g. Solar Installation"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-lime-400 focus:outline-none">
                    </div>
                </div>

                <!-- Message -->
                <div>
                    <label class="block text-base font-medium mb-1">Message <span class="text-red-500">*</span></label>
                    <textarea rows="4" placeholder="Write your message here..." asp-for="Remark"
                              class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-lime-400 focus:outline-none"></textarea>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="w-full sm:w-auto bg-yellow-400 text-black font-semibold py-3 px-6 rounded-full shadow hover:bg-yellow-500 transition-all duration-300">
                    Send Message
                </button>
            </form>
        </div>

        <!-- Right: Info Card -->
        <div class="w-full rounded-2xl shadow-lg p-6 sm:p-8 flex flex-col justify-between">
            <div>
                <button class="bg-yellow-400 px-4 py-1 rounded-full mb-4 hover:text-black transition-all hover:bg-yellow-500 duration-300">
                    Get in Touch
                </button>
                <h3 class="text-xl sm:text-2xl font-bold mb-3">Let's Power Progress with Citrine</h3>
                <p class="text-gray-500 mb-6 sm:mb-8">
                    Every message brings us closer to a cleaner, brighter tomorrow. We’re ready to listen.
                </p>

                <div class="space-y-4 text-sm sm:text-base">
                    <div class="flex items-start gap-3">
                        <span class="text-xl">📍</span>

                        <p>
                            <strong>Bhopal</strong> :-
                            S-1 Chaman Plaza, Sector - B
                            Indarpuri, Bhopal-462022
                            <br />
                            <strong>Noida</strong> :-
                            G-31, IInd Floor, Sector 63
                            Noida, Uttar Pradesh 201301
                        </p>

                    </div>
                    <div class="flex items-start gap-3">
                        <span class="text-xl">📞</span>
                        <p>
                            +91-755 356 9542
                            <br />
                            +91-887 891 8797
                        </p>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="text-xl">✉️</span>
                        <p>info@citrinetech.in</p>
                    </div>
                </div>
            </div>

            <div class="mt-6">
                <img src="~/img/ab.png" alt="Solar Illustration" class="w-full h-auto">
            </div>
        </div>

    </div>
</section>


<!-- FAQ Section -->
<section class="mx-3 max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
        <span class="inline-block border border-yellow-400 text-yellow-400 rounded-full px-3 py-1 text-xs mb-3">FAQ</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Everything You Need to Know</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
            From technology to timelines, find all the key answers in one place.
        </p>
    </div>

    <!-- FAQ Items -->
    <div class="space-y-4" id="faqContainer">
        <!-- First 3 FAQs (Visible by default) -->
        <div class="faq-item bg-blue-50 rounded-lg border border-gray-200 overflow-hidden">
            <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900">
                <span>What is cloud computing?</span>
                <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-900">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                Cloud computing delivers computing services over the internet, including storage, databases, and software.
            </div>
        </div>

        <div class="faq-item bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
            <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900">
                <span>How secure is cloud storage?</span>
                <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-900">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                Most cloud providers offer strong encryption and multi-factor authentication, but users must also follow best practices.
            </div>
        </div>

        <div class="faq-item bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
            <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900">
                <span>What is a VPN and why should I use one?</span>
                <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-900">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                A VPN encrypts your internet connection and hides your IP address, improving privacy and security online.
            </div>
        </div>

        <!-- Hidden FAQs (Revealed on button click) -->
        <div class="faq-item bg-gray-50 rounded-lg border border-gray-200 overflow-hidden hidden">
            <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900">
                <span>What is two-factor authentication?</span>
                <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-900">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                It’s a security process where users provide two different authentication factors to verify themselves.
            </div>
        </div>

        <div class="faq-item bg-gray-50 rounded-lg border border-gray-200 overflow-hidden hidden">
            <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900">
                <span>How do firewalls protect my network?</span>
                <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-900">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                Firewalls monitor and control incoming and outgoing network traffic based on security rules.
            </div>
        </div>
    </div>

    <!-- Show More Button -->
    <div class="mt-8 text-center">
        <button id="showMoreBtn" class="bg-yellow-400 hover:bg-yellow-500 text-black font-semibold px-6 py-2 rounded-full transition-all duration-300 mt-6">
            More Questions?
        </button>
    </div>

</section>

<script>
    document.getElementById('showMoreBtn').addEventListener('click', function () {
        const hiddenFaqs = document.querySelectorAll('#faqContainer .faq-item.hidden');
        hiddenFaqs.forEach(item => item.classList.remove('hidden'));
        this.style.display = 'none'; // Hide the button after expanding
    });
</script>













<!-- Why Choose Section         class="relative"-->
<section class="why-section max-w-7xl mx-auto px-4 py-20 grid md:grid-cols-2 gap-12 items-center rounded-2xl mb-8">
    <div >
        @* <div class="absolute -top-5 -left-5 bg-gradient-to-r from-yellow-400 to-yellow-600 px-4 py-3 rounded-xl shadow-xl">
            <i class="fa-solid fa-trophy text-white text-lg"></i>
            <span class="text-xs text-white uppercase tracking-wider">Top Innovation</span>
        </div> *@
        <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-lg">
            <img src="~/img/Tendências de computação em nuvem.jpg"
                 alt="Worker"
                 class="w-full rounded-2xl transition-transform duration-700 hover:scale-105">
        </div>
    </div>

    <div class="flex flex-col gap-8">
        <div>
            <button class="border border-yellow-600 text-yellow-600 rounded-full px-5 py-2 mb-6 hover:bg-white hover:text-[#0b1b13] transition duration-300">
                Why Choose Citrine
            </button>

            @* <span class="about-tag px-4 py-1 rounded-full text-sm font-semibold">Why Choose Citrine</span> *@
            
            <h2 class="about-title text-4xl font-bold leading-tight">
                Where Innovation <span>Meets Impact</span>
            </h2>

            <p class="text-gray-700 leading-relaxed mt-2">
                <span class="font-semibold">Citrine</span> blends innovation with technology-driven sustainability,
                providing IT solutions that fuel growth, reduce complexity, and strengthen communities across the globe.
            </p>
        </div>

        <div class="flex flex-col gap-4">
            <div class="flex gap-4 items-start">
                <div class="feature-index px-4 py-2 rounded-tl-lg rounded-bl-lg">01</div>
                <div class="feature-box rounded-2xl p-4 flex-1">
                    <h2 class="font-semibold mb-1 text-xl">Future-Ready Technology</h2>
                    <p>Citrine Technologies provides complete IT infrastructure management solutions.</p>
                </div>
            </div>

            <div class="flex gap-4 items-start">
                <div class="feature-index px-4 py-2 rounded-tl-lg rounded-bl-lg">02</div>
                <div class="feature-box rounded-2xl p-4 flex-1">
                    <h2 class="font-semibold mb-1 text-xl">Impact-Driven Sustainability</h2>
                    <p>We offer end-to-end IT services and dedicated technical teams for scalable success.</p>
                </div>
            </div>

            <div class="flex gap-4 items-start">
                <div class="feature-index px-4 py-2 rounded-tl-lg rounded-bl-lg">03</div>
                <div class="feature-box rounded-2xl p-4 flex-1">
                    <h2 class="font-semibold mb-1 text-xl">Trusted by Thousands</h2>
                    <p>Our team focuses on expertise, patience, and innovation to stay ahead of the curve.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="team-section mx-3 py-20 rounded-2xl shadow-inner mb-8">
    <div class="max-w-7xl mx-auto text-center space-y-10">
        @* <span class="about-tag px-4 py-1 rounded-full text-sm font-semibold">
            Our Expert Team
        </span> *@

        <button class="border border-yellow-600 text-yellow-600 rounded-full px-5 py-2 mb-6 hover:bg-white hover:text-[#0b1b13] transition duration-300">
            Our Expert Team
        </button>

        @* <h2 class="text-4xl font-bold text-gray-900 mb-5 my-2">Experts Behind Every Success</h2> *@

        <h2 class="about-title text-4xl font-bold leading-tight">
            Experts <span>Behind Every</span> Success
        </h2>

        <p class="text-gray-700 max-w-2xl mx-auto ">
            A team of passionate professionals driving innovation and excellence in every project we take on.
        </p>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4 mt-10">
            @foreach (var item in Model.Team)
            {
                <div class="team-card rounded-2xl overflow-hidden text-center shadow-lg">
                    <img src="@Url.Content("~/" + item.ImageUrl)"
                         alt="@item.Name"
                         class="w-full h-60 object-cover">
                    <div class="p-6">
                        <h3 class="font-bold text-lg mb-1">@item.Name</h3>
                        <p class="text-sm opacity-90 mb-3">@item.Designation</p>
                        <a href="#" class="inline-block border font-semibold px-4 py-2 rounded-full text-sm transition">
                            Learn More
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>












<!-- HERO Section -->
<section class="hero1 relative px-2 h-100 overflow-hidden mb-8 ">
    <div class="max-w-7xl mx-auto sm:px-6 py-12 flex flex-col md:flex-row items-center justify-between" style="margin-top:50px;">
        <div class="w-full md:w-1/2 text-center">
            <h2 class="text-5xl font-bold mb-2">@ViewData["Title"]</h2>
            <p class="text-lg">
                <a asp-action="Index">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>
        <div class="w-full md:w-1/2 flex justify-center">
            <img src="~/img/Fun.png" alt="Engineers" class="w-full max-w-md transition-transform duration-500">
        </div>
    </div>
</section>

<!-- About Section -->
<section class="mx-3 relative rounded-2xl sm:px-6 py-16 md:py-24 rounded-2xl">
    <div class="max-w-7xl mx-auto sm:px-6 py-20 flex flex-col md:flex-row items-center justify-between gap-12">
        <!-- Left -->
        <div class="w-full md:w-1/2 space-y-6" data-animate="slide-in-left">

            <button class="border border-yellow-600 text-yellow-600 rounded-full px-5 py-2 mb-6 hover:bg-white hover:text-[#0b1b13] transition duration-300">
                Who We Are
            </button>

            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
                Creating Impact Through <span class="text-yellow-600">Smart IT Innovation</span>
            </h2>

            <p class="text-gray-700 leading-relaxed sm:text-lg text-justify">
                <strong>Citrine IT Solutions</strong> is a technology-driven company dedicated to building a smarter,
                connected, and sustainable digital future. We empower businesses and communities worldwide through
                innovative IT services and intelligent transformation strategies.
            </p>


            <div class="grid sm:grid-cols-2 gap-6">
                <div class="about-card-dark p-6 rounded-2xl hover:-translate-y-1 transition-transform">
                    <h3 class="text-xl font-bold mb-2">Our Vision</h3>
                    <p class="text-sm">Empowering global progress with technology that simplifies complexity and accelerates growth.</p>
                </div>

                <div class="bg-gradient-to-br from-yellow-200 via-yellow-200 to-white text-black p-6 rounded-2xl shadow-lg hover:shadow-2xl transition-transform hover:-translate-y-1">
                    <h3 class="text-xl font-bold mb-2">Our Mission</h3>
                    <p class="text-sm">Delivering innovative IT solutions that transform businesses and inspire sustainable growth.</p>
                </div>
            </div>
        </div>

        <!-- Right -->
        <div class="w-full md:w-1/2" data-animate="slide-in-right">
            <button class="bg-yellow-400 text-black font-semibold px-6 py-2 rounded-full shadow-md hover:scale-105 transition">
                Get to Know Us 💻
            </button>
            <img src="~/img/It-1.jpg" alt="IT Team Working"
                 class="w-full rounded-2xl mt-6 shadow-2xl ">
        </div>
    </div>
</section>



<!-- HERO Section -->
<section class="hero1 relative px-2 h-100 overflow-hidden mb-8">
    <div class="max-w-7xl mx-auto sm:px-6 py-12 flex flex-col md:flex-row items-center justify-between">
        <div class="w-full md:w-1/2 text-center">
            <h2 class="text-5xl font-bold mb-2">@ViewData["Title"]</h2>
            <p class="text-lg">
                <a asp-action="Index">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>
        <div class="w-full md:w-1/2 flex justify-center">
            <img src="~/img/Fun.png" alt="Engineers" class="w-full max-w-md transition-transform duration-500">
        </div>
    </div>
</section>





<!-- Powering Solutions -->
<section class="mx-3 bg-gray-50 text-white sm:px-6 py-16 md:py-24 rounded-2xl">
    <div class="max-w-7xl mx-auto">

        <!-- Label + Title + Description + Metrics -->
        <div class="flex flex-col lg:flex-row justify-between gap-12 mb-16 ">

            <!-- Text Content -->
            <div class="lg:w-1/2 scroll-animate opacity-0" data-animate="slide-in-left">
                <button class="border border-black text-black rounded-full px-4 py-1 mb-6 hover:bg-black hover:text-white transition">
                    Powering Solutions
                </button>
                <h2 class="text-4xl md:text-5xl font-bold text-black leading-tight mb-4">
                    Revolutionizing IT for <br> Tomorrow’s Businesses
                </h2>
                <p class="text-gray-700 max-w-2xl">
                    At <strong>Citrine IT Solutions</strong>, we design and implement smart digital systems that help
                    people, organizations, and industries thrive — efficiently, sustainably, and intelligently in the
                    connected world.
                </p>
            </div>

            <!-- Metrics -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8 lg:gap-12 scroll-animate opacity-0 delay-150" data-animate="slide-in-right">
                <div>
                    <h3 class="text-5xl font-bold text-black counter" data-target="500">0</h3>
                    <p class="font-medium text-black">Projects Delivered</p>
                </div>
                <div class="sm:border-l border-gray-400 sm:pl-8">
                    <h3 class="text-5xl font-bold text-black counter" data-target="120">0</h3>
                    <p class="font-medium text-black">Global Clients Served</p>
                </div>
            </div>



        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 scroll-animate opacity-0 delay-150" data-animate="slide-in-up">

            <!-- Card 1 -->
            <div class="bg-lime-300 p-6 rounded-2xl text-black hover:bg-black hover:text-white transition-colors duration-1000 ease-in-out">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </div>
                <h4 class="font-bold text-lg mb-1">Custom Software Development</h4>
                <p class="text-sm">
                    We build tailored software solutions that empower businesses to innovate and scale efficiently.
                </p>
            </div>

            <!-- Card 2 -->
            <div class="bg-black text-white p-6 rounded-2xl">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3" />
                    </svg>
                </div>
                <h4 class="font-bold text-lg mb-1">Cloud & Infrastructure Services</h4>
                <p class="text-sm">
                    Scalable, secure cloud solutions designed to support enterprise growth and digital transformation.
                </p>
            </div>

            <!-- Card 3 -->
            <div class="bg-lime-300 p-6 rounded-2xl text-black hover:bg-black hover:text-white transition-colors duration-1000 ease-in-out">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18" />
                    </svg>
                </div>
                <h4 class="font-bold text-lg mb-1">IT Consulting & Strategy</h4>
                <p class="text-sm">
                    Guiding businesses with expert strategies to optimize operations and drive digital growth.
                </p>
            </div>

            <!-- Card 4 -->
            <div class="bg-lime-300 p-6 rounded-2xl text-black hover:bg-black hover:text-white transition-colors duration-1000 ease-in-out">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h4 class="font-bold text-lg mb-1">Cybersecurity & Maintenance</h4>
                <p class="text-sm">
                    Protecting businesses with advanced security solutions and 24/7 IT support services.
                </p>
            </div>
        </div>
    </div>
</section>


<!-- Services section -->
<section class="mx-3 bg-gray-50 rounded-2xl">
    <div class="max-w-7xl mx-auto py-16 px-4 text-left md:text-center scroll-animate opacity-0" data-animate="slide-in-left">
        <span class="inline-block border border-black rounded-full px-4 py-1 text-sm mb-4">
            Our Services
        </span>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Powering Success Through Renewable Services
        </h2>
        <p class="text-gray-600 mx-auto mb-10 text-left md:text-center">
            Presents successful <strong>Citrine Technology Pvt Ltd</strong> implementations of all IT systems and software technology in diverse sectors.
        </p>

        <!-- Grid Layout -->
        <div class="grid md:grid-cols-2 gap-8 ">
            @foreach (var item in Model.Services)
            {
                <div class="bg-[#0a2209] rounded-2xl overflow-hidden text-white flex flex-col md:flex-row shadow-md scroll-animate opacity-0 delay-150" data-animate="slide-in-right">
                    <div class="p-6 flex-1">
                        <p class="text-sm text-gray-300 mb-1">@item.SubTitle</p>
                        <h3 class="text-xl font-bold mb-2 text-lime-400">@item.Name</h3>
                        <p class="text-sm text-white/90 mb-4">
                            @item.Description
                        </p>
                        <button class="bg-lime-300 text-black font-semibold px-4 py-2 rounded-full text-sm hover:opacity-90 transition">
                            Read Detail
                        </button>
                        @* <div class="flex items-center gap-3 mt-4 text-sm text-white/80">
                    <span class="flex items-center gap-1"><i class="fas fa-building"></i> Urban Mall</span>
                    <span class="flex items-center gap-1"><i class="fas fa-map-marker-alt"></i>India</span>
                    </div> *@
                    </div>
                    <img src="@Url.Content("~/" + item.ImageUrl)"
                         alt="@item.Name" class="h-48 md:h-auto md:w-48 object-cover">
                </div>
            }
        </div>
    </div>
</section>

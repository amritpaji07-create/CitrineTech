<!-- Testimonials Section -->
<section class="mx-3 rounded-2xl sm:px-6 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Two-column layout -->
        <div class="flex flex-col lg:flex-row items-center lg:items-start gap-12">

            <!-- Left Image (50%) -->
            <div class="w-full lg:w-1/2 scroll-animate opacity-0" data-animate="slide-in-left">
                <img src="~/img/download.jpg" alt="Testimonial Image" class="w-full rounded-3xl object-cover" />
            </div>

            <!-- Right Content (50%) -->
            <div class="w-full lg:w-1/2 space-y-6 scroll-animate opacity-0 delay-150 z-10" data-animate="slide-in-right">
                <!-- Tag + Heading -->
                <div class="mb-12 lg:text-left">
                    <button class="border border-yellow-600 text-yellow-600 rounded-full px-5 py-2 mb-6 hover:bg-yellow-400 hover:text-[#0b1b13] transition duration-300">
                        What Our Clients Say Matters
                    </button>
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight mb-4">
                        Powered by Trust and Results
                    </h2>
                    <p class="text-gray-900 leading-relaxed text-base sm:text-lg text-center lg:text-left">
                        Every <strong>Citrine Technology</strong> customer experience reflects the trust and quality behind our services.
                    </p>
                </div>

                <!-- Swiper -->
                <div class="swiper mySwiper">
                    <div class="swiper-wrapper mb-8">
                        @foreach (var item in Model.Testimonial)
                        {
                            <div class="swiper-slide bg-gradient-to-br from-yellow-200 via-yellow-200 to-white text-black rounded-2xl p-6 relative flex flex-col gap-4">
                                <p class="italic font-semibold leading-relaxed">
                                    “@item.Description”
                                </p>
                                <div class="flex items-center gap-3 pt-2">
                                    <img src="~/img/avt.jpg" alt="@item.Name" class="w-10 h-10 rounded-full border-2 border-white" />
                                    <div>
                                        <p class="font-semibold">@item.Name</p>
                                        <p class="text-yellow-400 text-sm">@item.Designation</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="swiper-pagination mt-5"></div>
                </div>
            </div>
        </div>
    </div>
</section>







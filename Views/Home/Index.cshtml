@* blue-#070a7b *@
<style>
    .pulse-square {
        position: relative;
        width: 70px;
        height: 70px;
    }

        .pulse-square::before,
        .pulse-square::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100%;
            height: 100%;
            background: rgba(250, 204, 21, 0.3);
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
            animation: pulseSquare 2s infinite;
        }

        .pulse-square::after {
            animation-delay: 1s;
        }

    @@keyframes pulseSquare {
        0% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
        }

        100% {
            transform: translate(-50%, -50%) scale(2);
            opacity: 0;
        }
    }

    .EmpIT {
        margin-right: -10px;
    }

    @@media (max-width: 767px) {
        .EmpIT {
            margin: 1px;
        }
    }

    @@keyframes typing {
        from {
            width: 0;
        }

        to {
            width: 100%;
        }
    }

    @@keyframes blink {
        from, to {
            border-color: transparent;
        }

        50% {
            border-color: #facc15; /* Tailwind yellow-400 */
        }
    }

    /* Typewriter blinking cursor */
    .typewriter {
        display: inline-block;
        overflow: hidden;
        white-space: nowrap;
        border-right: 3px solid #facc15;
        width: 0;
        animation: typing 3s steps(40, end) forwards, blink 0.7s step-end infinite;
    }

    #heroText::after {
        content: '|';
        margin-left: 6px;
        color: #facc15; /* Tailwind yellow-400 */
        animation: blink 0.8s infinite;
    }

    /* Text glow animation */
    .typewriter-glow {
        text-shadow: 0 0 8px rgba(250, 204, 21, 0.6), 0 0 16px rgba(250, 204, 21, 0.4);
        transition: text-shadow 0.3s ease-in-out;
    }

    /* Cursor blink */
    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    /* about-tag {
                                        border: 1px solid var(--orange);
                                        color: var(--oxford-blue);
                                        background: rgba(252, 163, 17, 0.1);
                                    }

                                    .about-title span {

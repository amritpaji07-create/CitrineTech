<!-- Form Section -->
<section class="mx-3 bg-[#0e2e1d] rounded-3xl overflow-hidden py-16 px-4 rounded-2xl " style="display:none;">
    <div class="max-w-7xl mx-auto max-w-7xl">
        <div class="flex flex-col md:flex-row items-center gap-12">
            <!-- Left Content -->
            <div class="w-full md:w-1/2 text-white  scroll-animate opacity-0" data-animate="slide-in-left">
                <span class="inline-block bg-yellow-400 text-black font-semibold text-sm px-4 py-1 rounded-full mb-4 ">
                    Powered by Trust and Results
                </span>
                <h2 class="text-4xl sm:text-5xl font-bold leading-tight mb-4  ">
                    Ready to switch to IT?<br />Let’s start the journey.
                </h2>
                <p class="text-white/90 text-base mb-6 max-w-lg leading-relaxed  ">
                    With <strong>IT Technology</strong>, IT solutions aren’t complicated — they’re reliable, intelligent, and built to perform.
                    Together, let’s power the future with clean, smart, and sustainable innovation.
                </p>
                <button class="bg-white text-black font-semibold px-6 py-2 rounded-full hover:scale-105 transition-transform glow hover:text-yellow-400">
                    Explore Solutions ⚡
                </button>
            </div>

            <!-- Right Form -->
            <div class="w-full md:w-1/2  scroll-animate opacity-0" data-animate="slide-in-up">
                <div class="bg-white rounded-t-2xl p-6 shadow-lg mb-[-69px] md:mb-[-183px] lg:mb-[-80px] xl:mb-[-75px]">

                    <h3 class="text-2xl font-bold mb-6 text-black">Get Your Free Consultation</h3>
                    <form class="space-y-4 ">
                        <!-- Name -->
                        <div>
                            <label class="block text-sm font-semibold text-black mb-1">
                                Your Name <span class="text-red-500">*</span>
                            </label>
                            <input type="text" placeholder="e.g. Sameer Patel"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" />
                        </div>

                        <!-- Email -->
                        <div>
                            <label class="block text-sm font-semibold text-black mb-1">
                                Email <span class="text-red-500">*</span>
                            </label>
                            <input type="email" placeholder="e.g. sameer123@gmail.com"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" />
                        </div>

                        <!-- Message -->
                        <div>
                            <label class="block text-sm font-semibold text-black mb-1">
                                Message <span class="text-red-500">*</span>
                            </label>
                            <textarea rows="2" placeholder="Tell us what you need here..."
                                      class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400"></textarea>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="w-full bg-yellow-400 text-black font-16 px-6 py-3 rounded-full hover:opacity-90 transition">
                            Free Consultation
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Scroller   w-[85%] -->
<section class="bg-white py-12 px-4 flex justify-end">
    <div class="relative overflow-hidden">
        <!-- Title -->
        <h2 class="max-w-7xl mx-auto sm:px-6 py-20 text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-4">
            Our Solutions – <span class="text-yellow-600">Our Strength</span>
        </h2>

        <!-- Navigation Arrows -->
        <button class="absolute left-0 top-1/2 -translate-y-1/2 bg-yellow/40 text-black p-3 rounded-full opacity-0 hover:opacity-100 transition"
                onclick="prevSlide()">
            &#8592;
        </button>

        <button class="absolute right-0 top-1/2 -translate-y-1/2 bg-yellow/40 text-black p-3 rounded-full opacity-0 hover:opacity-100 transition"
                onclick="nextSlide()">
            &#8594;
        </button>

        <!-- Slider Wrapper -->
        <style>
            @@keyframes slide {
                0% {
                    transform: translateX(0);
                }

                100% {
                    transform: translateX(-50%);
                }
            }

            /* Continuous sliding */
            .animate-slide {
                display: flex;
                gap: 1.5rem; /* matches Tailwind gap-6 */
                animation: slide 20s linear infinite;
                width: max-content;
                transition: transform 0.5s ease-in-out;
            }

            /* Pause on hover */
            .carousel-wrapper:hover .animate-slide {
                animation-play-state: paused;
            }
        </style>

        <div class="carousel-wrapper overflow-hidden w-full">
            <div id="carousel" class="animate-slide">
                <!-- Original items -->
                @foreach (var item in Model.SubSolution)
                {
                    <div class="relative w-[250px] h-[300px] md:w-[280px] md:h-[320px] lg:w-[300px] lg:h-[340px] rounded-2xl shadow-lg overflow-hidden group mx-auto">
                        <a asp-action="Details" asp-controller="SubSolution" asp-route-id="@item.Id" class="block w-full h-full">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-yellow-400/70 via-yellow-200/50 to-white/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-center px-2">
                                <span class="text-white font-semibold text-lg sm:text-xl md:text-2xl drop-shadow-md group-hover:underline">
                                    @item.Name
                                </span>
                            </div>
                        </a>
                    </div>
                }

                <!-- Duplicate items for seamless loop -->
                @* @foreach (var item in Model.SubSolution)
                {
                <div class="relative w-[250px] h-[300px] md:w-[280px] md:h-[320px] lg:w-[300px] lg:h-[340px] rounded-2xl shadow-lg overflow-hidden group mx-auto">
                <a asp-action="Details" asp-controller="SubSolution" asp-route-id="@item.Id" class="block w-full h-full">
                <img src="@item.ImageUrl"
                alt="@item.Name"
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-yellow-400/70 via-yellow-200/50 to-white/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-center px-2">
                <span class="text-white font-semibold text-lg sm:text-xl md:text-2xl drop-shadow-md group-hover:underline">

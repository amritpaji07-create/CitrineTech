@using CitrineTechData.DataModel
@model Contact

@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<style>

    /* === Common Palette === */
    :root {
        --oxford-blue-dark: #0c1425;
        --oxford-blue: #14213d;
        --oxford-blue-light: #29447e;
        --orange: #fca311;
        --orange-light: #fec871;
        --platinum: #e5e5e5;
        --white: #ffffff;
        --black: #000000;
    }


    .scroll-zoom {
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    #scrollBlogContent {
        transform-origin: center;
    }

    section {
        scroll-margin-top: 100px;
    }

    /* === HERO SECTION === */
    .hero1 {
        background: linear-gradient(135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100%);
        color: var(--white);
        position: relative;
        overflow: hidden;
    }

        .hero1::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(252,163,17,0.25), transparent 70%), radial-gradient(circle at bottom left, rgba(20,33,61,0.4), transparent 70%);
            opacity: 0.8;
        }

        .hero1 h2 {
            color: var(--orange);
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
        }

        .hero1 a {
            color: var(--orange);
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .hero1 a:hover {
                color: var(--orange-light);
                text-decoration: underline;
            }

</style>




<!-- 🌟 Hero Section -->

<section class="hero1 relative px-2 h-100 overflow-hidden mb-8">
    <div class="max-w-7xl mx-auto text-white flex flex-col md:flex-row items-center justify-between py-12 md:py-16">

        <!-- Left Content -->
        <div class="w-full md:w-1/2 text-center md:text-left space-y-4">
            <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
                @ViewData["Title"]
            </h2>
            <p class="text-yellow-400">
                <a asp-action="Index" class="hover:text-white transition">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>

        <!-- Right Image -->
        <div class="w-full md:w-1/2 flex justify-center mt-6 md:mt-0">
            <img src="~/img/1-Photoroom-removebg-preview.png"
                 alt="Contact Team"
                 class="w-full max-w-sm sm:max-w-md drop-shadow-2xl animate-float">
        </div>
    </div>
</section>

<!-- 💬 Contact Section -->
<section class="mx-3 py-16 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Left: Contact Form -->
        <div class="bg-white/80 backdrop-blur-md rounded-2xl border border-yellow-300 shadow-xl p-6 sm:p-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Send Us a Message</h2>
            <p class="text-gray-600 mb-8">
                Have questions or want to get started? Fill out the form and our team will reach out soon.
            </p>

            <form asp-action="ContactCreate" asp-controller="Contact" enctype="multipart/form-data" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="bg-red-100 text-red-700 p-4 rounded-md"></div>

                <!-- Name + Email -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-gray-800 mb-1">Your Name <span class="text-red-500">*</span></label>
                        <input asp-for="Name" type="text" placeholder="e.g. Jason Samuel"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-yellow-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block font-medium text-gray-800 mb-1">Your Email <span class="text-red-500">*</span></label>
                        <input asp-for="Email" type="email" placeholder="e.g. test@gmail.com"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-yellow-400 focus:outline-none">
                    </div>
                </div>

                <!-- Phone + Subject -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-gray-800 mb-1">Phone <span class="text-red-500">*</span></label>
                        <input asp-for="ContactNo" type="text" placeholder="e.g. 9876543210"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-yellow-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block font-medium text-gray-800 mb-1">Subject <span class="text-red-500">*</span></label>
                        <input type="text" placeholder="e.g. Solar Installation"
                               class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-yellow-400 focus:outline-none">
                    </div>
                </div>

                <!-- Message -->
                <div>
                    <label class="block font-medium text-gray-800 mb-1">Message <span class="text-red-500">*</span></label>
                    <textarea asp-for="Remark" rows="4" placeholder="Write your message here..."
                              class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-yellow-400 focus:outline-none"></textarea>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600 text-black font-semibold py-3 px-8 rounded-full shadow-lg hover:shadow-yellow-400/50 transition-all duration-300">
                    Send Message
                </button>
            </form>
        </div>

        <!-- Right: Contact Info -->
        <div class="bg-gradient-to-br from-green-50 via-yellow-50 to-white rounded-2xl border border-yellow-200 shadow-xl p-6 sm:p-10 flex flex-col justify-between">
            <div>
                <span class="inline-block border border-yellow-400 text-yellow-500 px-4 py-1 rounded-full text-sm font-medium mb-5">
                    Get in Touch
                </span>
                <h3 class="text-2xl font-bold mb-4 text-gray-800">Let's Power Progress with Citrine</h3>
                <p class="text-gray-600 mb-8">
                    Every message brings us closer to a cleaner, brighter tomorrow. We’re ready to listen and collaborate.
                </p>

                <div class="space-y-5 text-gray-700">
                    <div class="flex items-start gap-3">
                        <span class="text-yellow-500 text-xl">📍</span>
                        <p>
                            <strong>Bhopal</strong>: S-1 Chaman Plaza, Sector-B, Indrapuri, Bhopal - 462022<br>
                            <strong>Noida</strong>: G-31, 2nd Floor, Sector-63, Noida, UP 201301
                        </p>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="text-yellow-500 text-xl">📞</span>
                        <p>
                            +91-755 356 9542<br>
                            +91-887 891 8797
                        </p>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="text-yellow-500 text-xl">✉️</span>
                        <p>info@citrinetech.in</p>
                    </div>
                </div>
            </div>

            <div class="mt-8">
                <img src="~/img/ab.png" alt="Citrine Illustration" class="w-full rounded-xl shadow-lg">
            </div>
        </div>
    </div>
</section>

<!-- ❓ FAQ Section -->
<section class="mx-3 max-w-7xl mx-auto px-4 py-20">
    <div class="text-center mb-10">
        <span class="inline-block border border-yellow-400 text-yellow-500 rounded-full px-3 py-1 text-xs mb-3">FAQ</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Everything You Need to Know</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
            From technology to timelines, find all the key answers in one place.
        </p>
    </div>

    <div class="space-y-4" id="faqContainer">
        <!-- Example FAQ Item -->
        @foreach (var faq in new[] {
                new {Q="What is cloud computing?", A="Cloud computing delivers computing services over the internet, including storage, databases, and software."},
                new {Q="How secure is cloud storage?", A="Most cloud providers offer strong encryption and multi-factor authentication, but users must also follow best practices."},
                new {Q="What is a VPN and why should I use one?", A="A VPN encrypts your internet connection and hides your IP address, improving privacy and security online."},
                new {Q="What is two-factor authentication?", A="It’s a process where users provide two different authentication factors to verify themselves."},
                new {Q="How do firewalls protect my network?", A="Firewalls monitor and control network traffic based on security rules."}
                })
        {
            <div class="faq-item bg-white rounded-lg border border-gray-200 shadow hover:shadow-lg transition overflow-hidden">
                <button class="faq-btn flex justify-between items-center w-full px-5 py-4 text-left font-semibold text-gray-900 hover:text-yellow-600">
                    <span>@faq.Q</span>
                    <span class="faq-icon w-6 h-6 flex items-center justify-center rounded-full border border-gray-400 text-gray-700">+</span>
                </button>
                <div class="faq-content hidden px-5 pb-4 text-sm text-gray-700">
                    @faq.A
                </div>
            </div>
        }
    </div>

    <div class="mt-10 text-center">
        <button id="showMoreBtn" class="bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600 text-black font-semibold px-8 py-3 rounded-full shadow-lg hover:shadow-yellow-400/40 transition-all duration-300">
            More Questions?
        </button>
    </div>
</section>

<script>
    document.getElementById('showMoreBtn').addEventListener('click', function () {
        const hiddenFaqs = document.querySelectorAll('#faqContainer .faq-item.hidden');
        hiddenFaqs.forEach(item => item.classList.remove('hidden'));
        this.style.display = 'none';
    });

    // FAQ Toggle Logic
    document.querySelectorAll('.faq-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const content = btn.nextElementSibling;
            const icon = btn.querySelector('.faq-icon');
            content.classList.toggle('hidden');
            icon.textContent = icon.textContent === '+' ? '–' : '+';
        });
    });
</script>

<style>
    /* Smooth float animation for hero image */
    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }

    }

    .animate-float {
        animation: float 4s ease-in-out infinite;
    }
</style>

<style>
    .stats-section {
        background: #000;
        color: whitesmoke;
        padding: 60px 20px;
        gap: 15px;
        flex-wrap: wrap; /* responsive stacking */
        margin-top: 100px;
    }

    /* Left Grid */
    /* Left Grid */ .stats-grid {
        display: grid;
        grid-template-columns: 200px 200px;
        grid-template-rows: 200px 200px;
        gap: 10px;
        flex: 1; /* margin-top:-120px; */
    }

    .stat-item {
        background: #ffb030;
        color: #000;
        font-weight: bold;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        clip-path: ellipse(55% 82% at 50% 50%);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }
    /* Individual corner rounding */

    .top-left {
        border-top-left-radius: 50%;
    }

    .top-right {
        border-top-right-radius: 50%;
    }

    .bottom-left {
        border-bottom-left-radius: 50%;
    }

    .bottom-right {
        border-bottom-right-radius: 50%;
    }

    /* Right Content Box */
    .content-box {
        flex: 1;
        background: #111;
        color: #fff;
        border-radius: 20px;
        padding: 40px;
        /* box-shadow: 0 10px 30px rgb(232 210 155 / 60%); */
        box-shadow: rgba(232 210 155 / 60%) 0px 14px 28px, rgba(232 210 155 / 60%) 0px 10px 10px;
        max-width: 600px;
        min-width: 280px;
    }

        .content-box button {
            border: 2px solid #ffb030;
            color: #ffb030;
            background: transparent;
            border-radius: 50px;
            padding: 8px 18px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

            .content-box button:hover {
                background: #ffb030;
                color: #000;
            }

        .content-box h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 20px;
            line-height: 1.3;
            color: goldenrod;
        }

        .content-box p {
            color: #ccc;
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

    /* Content Cards */
    .content-card {
        padding: 20px;
        border-radius: 16px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .content-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
        }

    .vision-card {
        background: #000;
        color: #fff;
    }

    .mission-card {
        background: #ffb030;
        color: #000;
    }

    /* 🔹 Responsive Breakpoints */
    @@media (max-width: 992px) {
        .stats-section {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .content-box {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: auto;
        }

        .content-box h2 {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr; /* stack stats vertically */
        }

        .stat-item {
            padding: 15px;
        }

        .content-box {
            padding: 20px;
        }

            .content-box h2 {
                font-size: 1.5rem;
            }

            .content-box p {
                font-size: 0.9rem;
            }
    }
</style>


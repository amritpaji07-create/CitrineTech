.sphere-section {
  text-align: center;
  padding: 80px 0;
  background: #111;
  color: #fff;
}
.sphere {
  position: relative;
  width: 300px;
  height: 300px;
  margin: 0 auto;
  transform-style: preserve-3d;
  animation: rotateSphere 15s infinite linear;
}
.sphere span {
  position: absolute;
  top: 50%; left: 50%;
  transform-style: preserve-3d;
  transform: rotateY(calc(var(--i) * 60deg)) translateZ(140px);
}
.sphere img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}
@@keyframes rotateSphere {
  from { transform: rotateY(0deg) rotateX(0deg); }
  to   { transform: rotateY(360deg) rotateX(360deg); }
}
</style>

<style>
.orbit {
  position: relative;
  width: 300px;
  height: 300px;
  margin: 80px auto;
  border-radius: 50%;
  animation: spin 20s linear infinite;
}
.center-logo {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40px;
}
.orbit-logo {
  position: absolute;
  top: 50%; left: 50%;
  transform-origin: -120px;
}
.orbit-logo img {
  width: 60px; height: 60px;
}
.orbit-logo:nth-child(2) { transform: rotate(0deg) translateX(120px); }
.orbit-logo:nth-child(3) { transform: rotate(90deg) translateX(120px); }
.orbit-logo:nth-child(4) { transform: rotate(180deg) translateX(120px); }
.orbit-logo:nth-child(5) { transform: rotate(270deg) translateX(120px); }
@@keyframes spin {
  100% { transform: rotate(360deg); }
}
</style>

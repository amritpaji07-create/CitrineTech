@using System.Linq *@

@{
    ViewData["Title"] = "Our Solutions";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";

    // var project = Model.Projects.FirstOrDefault(); // Or use a specific index or filter by ID/Name
}


<!-- HERO SECTION -->
<style>
    /* === Common Palette === */
    :root {
        --oxford-blue-dark: #0c1425;
        --oxford-blue: #14213d;
        --oxford-blue-light: #29447e;
        --orange: #fca311;
        --orange-light: #fec871;
        --platinum: #e5e5e5;
        --white: #ffffff;
        --black: #000000;
    }

    /* === General Styles === */
    section {
        scroll-margin-top: 100px;
    }

    .scroll-zoom {
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    #scrollBlogContent {
        transform-origin: center;
    }

    /* === HERO SECTION STYLES === */
    .hero1 {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, var(--oxford-blue-dark) 0%, var(--oxford-blue) 50%, var(--oxford-blue-light) 100% );
        color: var(--white);
    }

        .hero1::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(252,163,17,0.25), transparent 70%), radial-gradient(circle at bottom left, rgba(20,33,61,0.4), transparent 70%);
            opacity: 0.8;
        }

        .hero1 h2 {
            color: var(--orange);
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
        }

        .hero1 a {
            color: var(--orange);
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .hero1 a:hover {
                color: var(--orange-light);
                text-decoration: underline;
            }

</style>

<section class="hero1 relative px-2 h-100 overflow-hidden mb-8">
    <div class="max-w-7xl mx-auto sm:px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-sm-2" style="margin-top:50px;">

        <!-- Left Content -->
        <div class="w-full md:w-1/2 flex flex-col items-center text-center py-12 z-10">
            <h2 class="text-4xl sm:text-5xl font-bold mb-2">@ViewData["Title"]</h2>
            <p class="text-yellow-400 scroll-animate opacity-0" data-animate="slide-in-left">
                <a asp-action="Index">Home</a>
                <span class="text-white"> – @ViewData["Title"]</span>
            </p>
        </div>

        <!-- Right Image -->
        <div class="w-full md:w-1/2 flex items-center justify-center relative overflow-hidden">
            <img id="scrollImage"
                 src="~/img/Fun.png"
                 alt="Engineers"
                 class="w-full h-auto transition-transform duration-300 ease-out will-change-transform" />
        </div>

    </div>
</section>

<script>
    window.addEventListener("scroll", function () {
        // === HERO IMAGE SCROLL EFFECT ===
        const image = document.getElementById("scrollImage");
        const hero = document.querySelector(".hero1");
        const heroRect = hero.getBoundingClientRect();

        let imageProgress = 1 - heroRect.bottom / window.innerHeight;
        imageProgress = Math.min(Math.max(imageProgress, 0), 1);

        const imageScale = 1 + imageProgress * 0.8;  // 1 → 1.8
        const imageOpacity = 1 - imageProgress * 0.6; // 1 → 0.4

        image.style.transform = `scale(${imageScale})`;
        image.style.opacity = imageOpacity;

        // === BLOG CONTENT SCROLL EFFECT ===
        const content = document.getElementById("scrollBlogContent");
        if (content) {
            const rect = content.getBoundingClientRect();
            let progress = 1 - rect.bottom / window.innerHeight;
            progress = Math.min(Math.max(progress, 0), 1);

            const translateY = progress * -40;
            const scale = 1 + progress * 0.1;
            const opacity = 1 - progress * 0.6;

            content.style.transform = `translateY(${translateY}px) scale(${scale})`;
            content.style.opacity = opacity;
        }
    });
</script>

<!-- SOLUTIONS SECTION -->
<style>
    /* Card hover effect */
    .solution-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        border: 2px solid transparent;
        border-radius: 1rem; /* Rounded corners for card */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: linear-gradient(145deg, var(--oxford-blue), var(--oxford-blue-light));
    }

        .solution-card:hover {
            transform: translateY(-5px);
            border-color: #fca311; /* Orange border on hover */
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

        /* Image styles */
        .solution-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .solution-card:hover img {
            transform: scale(1.05); /* Slight zoom on hover */
        }
</style>

<section class="mx-3 py-20">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8">
        @foreach (var item in Model)
        {
            <div class="solution-card scroll-animate opacity-0 delay-150" data-animate="slide-in-up">

                <!-- Image on Top -->
                <img src="/@item.ImageUrl" alt="@item.Name" class="rounded-t-lg" />

                <!-- Content -->
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <p class="text-sm text-gray-300 mb-1">@item.SubTitle</p>
                        <h3 class="text-xl font-bold mb-2 text-yellow-300">@item.Name</h3>
                        <p class="text-sm text-white/90 mb-4 text-justify">
                            @item.Description
                        </p>
                    </div>

                    <!-- Button -->
                    <div class="mt-auto">
                        <button class="bg-yellow-500 text-black font-semibold px-4 py-2 rounded-full text-sm hover:opacity-90 transition">
                            <a href="@Url.Action("Details", "Solution", new { id = item.Id })">Read Detail</a>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>



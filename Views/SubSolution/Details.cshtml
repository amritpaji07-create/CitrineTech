@model CitrineTechData.ViewModel.SubSolutionViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";

    var imagePath = Model.ImagePaths != null && Model.ImagePaths.Any()
        ? Model.ImagePaths.First()
        : "~/img/default.jpg";

}

<!-- 🌈 Modern Styles & Animation Enhancements -->
<style>
    /* Scroll-based fade and slide animation */
    [data-animate] {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
    }

        [data-animate].visible {
            opacity: 1;
            transform: translateY(0);
        }

    #scrollImage {
        transition: transform 0.6s ease, opacity 0.6s ease;
    }

    /* Floating default images */
    .floating-img {
        position: absolute;
        opacity: 0.25;
        filter: blur(0.5px) brightness(1.1);
        animation: float 8s ease-in-out infinite;
        transition: all 0.6s ease;
        will-change: transform;
    }

        .floating-img:hover {
            opacity: 0.6;
            filter: brightness(1.3);
            transform: scale(1.05);
        }

    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-20px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    /* Glassmorphic card */
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 215, 0, 0.4);
    }

    .sub-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }

    .gradient-text {
        background: linear-gradient(to right, #facc15, #fff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .divider {
        height: 3px;
        width: 80px;
        margin: 1.5rem auto;
        background: linear-gradient(to right, #facc15, #fbbf24, #facc15);
        border-radius: 2px;
    }
</style>
<!-- 🌟 HERO SECTION -->
<section class="relative overflow-hidden bg-gradient-to-r from-black via-gray-900 to-black shadow-2xl">
    <!-- Floating Default Images -->
    @* <img src="~/assets/123.png" class="floating-img w-24 top-10 left-16 animate-pulse" style="animation-delay: 0s;" alt="Floating Icon" />
    <img src="~/img/icons/ai.png" class="floating-img w-28 bottom-12 right-10" style="animation-delay: 2s;" alt="AI Icon" />
    <img src="~/img/icons/data.png" class="floating-img w-20 top-1/3 right-1/4" style="animation-delay: 4s;" alt="Data Icon" />
    *@
    <div class="max-w-7xl mx-auto text-white px-6 py-20 flex flex-col md:flex-row items-center justify-between gap-10 relative z-10">
        <!-- Left Content -->
        <div class="flex-1 text-center md:text-left space-y-6" data-animate>
            <h1 class="text-5xl md:text-6xl font-extrabold gradient-text drop-shadow-xl">
                @Model.Name
            </h1>
            <p class="text-lg text-gray-300 max-w-lg leading-relaxed">
                Empowering your business with cutting-edge digital solutions crafted to deliver performance, precision, and excellence.
            </p>
        </div>

        <!-- Right Image -->
        <div class="flex-1 flex justify-center relative" data-animate>
            <img id="scrollImage"
                 src="~/assets/123.png"
                 alt="Service Image"
                 class="max-w-md w-full rounded-2xl shadow-2xl opacity-95  hover:opacity-100 transition-all duration-700" />
        </div>
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
</section>

<!-- 🌍 MAIN CONTENT -->
<section id="scrollBlogContent" class="relative max-w-5xl mx-auto my-20 px-4">
    <div class="rounded-2xl overflow-hidden shadow-2xl border border-yellow-400 bg-white/80 backdrop-blur-md" data-animate>
       
        <img src="@Url.Content("~/" +(imagePath))"
             alt="@Model.Name"
             class="w-full h-[400px] object-cover" />

        <div class="p-10 space-y-6 text-gray-800">
            <h2 class="text-4xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
                @Model.Name
            </h2>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-lg leading-relaxed text-justify">
                    @Model.Description
                </p>
            }
        </div>
    </div>
</section>


<!-- 🧠 SCROLL ANIMATIONS -->
<script>
    // Scroll Zoom for Hero Image
    window.addEventListener("scroll", () => {
        const img = document.getElementById("scrollImage");
        const rect = img.getBoundingClientRect();
        const progress = Math.max(0, 1 - rect.top / window.innerHeight);
        const scale = 1 + progress * 0.3;
        const opacity = 1 - progress * 0.3;
        img.style.transform = `scale(${scale})`;
        img.style.opacity = opacity;
    });

    // Reveal Animation
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.2 });

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
</script>
